PUBLIC_SITE_URL=https://example.com

# Google Analytics 4
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Sheets Integration
# Deploy scripts/google-apps-script.gs as Google Apps Script Web App
# and copy the deployment URL here
GOOGLE_SHEETS_WEBHOOK=https://script.google.com/macros/d/{DEPLOYMENT_ID}/usercontent

# Contact Information (optional - if not set, uses placeholders in landing.ts)
CONTACT_NAME=Contact Person
CONTACT_PHONE=+84 (0) 123 456 789
CONTACT_PHONE_HREF=+84123456789
CONTACT_EMAIL=contact@example.com
CONTACT_EMAIL_HREF=contact@example.com

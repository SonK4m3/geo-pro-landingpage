# Production environment template
# Copy these values to your hosting platform's environment variables section

# Required: Set this to your production domain
PUBLIC_SITE_URL=https://yourdomain.com

# Required: Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com (format: G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Required: Google Apps Script webhook for form submissions
# Deploy scripts/google-apps-script.gs and copy the URL
GOOGLE_SHEETS_WEBHOOK=https://script.google.com/macros/d/{ID}/usercontent

# Contact Information
CONTACT_NAME=Your Name
CONTACT_PHONE=+84 901 234 567
CONTACT_PHONE_HREF=+84901234567
CONTACT_EMAIL=contact@example.com
CONTACT_EMAIL_HREF=contact@example.com
